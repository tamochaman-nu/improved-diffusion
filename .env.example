# Copy this file to .env and set the paths to your own dataset directories.
# docker-compose.yml mounts HOST_DATA_DIR_ANIME into the train-anime service
# and HOST_DATA_DIR_FFHQ into the train-ffhq service, both at /app/data.
HOST_DATA_DIR_ANIME=/path/to/your/anime-style-dataset
HOST_DATA_DIR_FFHQ=/path/to/your/real-photo-dataset

# Base image for the Docker build. Must not require a newer CUDA than the host
# driver supports (see "CUDA Version" in nvidia-smi). Leave unset to use the
# default (CUDA 12.4, needs driver >= 550). Use a different IMAGE_TAG per CUDA
# version so builds on different machines don't overwrite each other.
# Example for driver 545 (CUDA 12.3):
#BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel
#IMAGE_TAG=cu121

# --- inference (docker compose run --rm inference) ---
# どの学習runから生成するか。./logs/<SAMPLE_RUN> にあるチェックポイントを読む。
SAMPLE_RUN=anime-oneres-cosine
# 使うGPUの番号 (nvidia-smiのindex)。他の学習が使っていないGPUを選ぶこと。
#SAMPLE_GPU=0
# チェックポイントの指定。優先順位: MODEL_PATH > CKPT_STEP > 最新のEMA。
# MODEL_PATHは.ptファイルまで指定する(ディレクトリ不可)。./logs/... と同じ相対パスで書ける。
# 生の重み(EMAでない)を使う例: 学習ステップが少ないうちはEMAに初期値が残るため有効。
#MODEL_PATH=logs/anime-oneres-cosine/model020000.pt
# CKPT_STEP=20000 なら ema_<EMA_RATE>_020000.pt を使う(EMAのみ)。
#CKPT_STEP=20000
#EMA_RATE=0.9999
# サンプラー設定。TIMESTEP_RESPACINGを空にするとフルステップ(遅い)。DDIMなら
# TIMESTEP_RESPACING=ddim50 と USE_DDIM=True を併用する。
#TIMESTEP_RESPACING=250
#USE_DDIM=False
#NUM_SAMPLES=16
#SAMPLE_BATCH_SIZE=16
# 出力先を直接指定する場合(コンテナ内パス)。未指定なら ./logs/<SAMPLE_RUN>/samples/ 以下に自動で分かれる。
#SAMPLE_OUTDIR=/app/logs/my-samples
